// AMS2 dedicated server configuration.
// Generated by ams2-server-panel.
// You can still edit it by hand; the panel reads it back on every load.


//////////////////////////
// Basic server options //
//////////////////////////

// debug / info / warning / error
logLevel : "info"
// Number of gameplay events kept in memory
eventsLogSize : 10000
// Server name shown in the browser
name : "AMS2 server"
// Check VAC bans through Steam
secure : true
// Password to join (empty = open server)
password : ""
// Largest session that can be created (the game supports max 32)
maxPlayerCount : 32
// Empty = all interfaces
bindIP : ""
// These three ports must be reachable on the public IP
steamPort : 8766
hostPort : 27015
queryPort : 27016
// Tick delay in ms while idle
sleepWaiting : 50
// Tick delay in ms while hosting
sleepActive : 10
// LAN-only mode with system sockets
sportsPlay : false

///////////////////////////////////////////////////////////////////
// HTTP API (the control panel talks to the server through this) //
///////////////////////////////////////////////////////////////////

enableHttpApi : true
httpApiLogLevel : "warning"
// 127.0.0.1 = only this machine can reach it
httpApiInterface : "127.0.0.1"
httpApiPort : 9000

////////////////
// Lua addons //
////////////////

enableLuaApi : true
luaAddonRoot : "lua"
luaConfigRoot : "lua_config"
luaOutputRoot : "lua_output"
// Loaded in this order; sms_base is always loaded
luaApiAddons : [
    "sms_base",
    "sms_rotate",
    "sms_motd",
    "sms_stats"
]
luaAllowedLibraries : [
    "lib_rotate"
]

////////////////
// Game setup //
////////////////

// Show the server in the browser even when empty
allowEmptyJoin : true
// true = the server (and this panel) controls the setup, not the host player
controlGameSetup : true
// Initial session settings, see /api/list/attributes/session
sessionAttributes : {
    "ServerControlsTrack": 1,
    "ServerControlsVehicleClass": 0,
    "ServerControlsVehicle": 0,
    "GridSize": 24,
    "MaxPlayers": 24,
    "PracticeLength": 0,
    "QualifyLength": 0,
    "RaceLength": 3,
    "Flags": 656104,
    "OpponentDifficulty": 50,
    "DamageType": 1,
    "TireWearType": 8,
    "FuelUsageType": 2,
    "PenaltiesType": 1,
    "AllowedViews": 0,
    "TrackId": -1478712571,
    "VehicleClassId": 492525831,
    "VehicleModelId": 1323381033,
    "RaceDateHour": 11,
    "RaceWeatherSlots": 1,
    "RaceWeatherSlot1": -934211870,
    "RaceWeatherSlot2": -934211870,
    "RaceWeatherSlot3": -934211870,
    "RaceWeatherSlot4": -934211870
}
